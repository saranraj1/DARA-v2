# ============================================================
# DARA — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- LLM Providers ---
GROQ_API_KEY=                          # console.groq.com (free, primary LLM)
GOOGLE_API_KEY=                        # aistudio.google.com (free, fallback LLM)
HUGGINGFACE_API_TOKEN=                 # huggingface.co/settings/tokens (embeddings fallback)
COHERE_API_KEY=                        # dashboard.cohere.com (reranker)
LLM_MODE=local                         # "local" (ollama) or "groq" (api)
LLM_MODEL_NAME=deepseek-coder-v2:16b   # ollama model name or groq model

# --- GitHub App ---
GITHUB_APP_ID=                         # From github.com/settings/apps → your app
GITHUB_PRIVATE_KEY_PATH=config/github_app.pem   # Downloaded .pem file path
GITHUB_WEBHOOK_SECRET=                 # Random string set in GitHub App webhook settings
GITHUB_INSTALLATION_ID=               # From github.com/settings/installations/XXXXX

# --- Slack ---
SLACK_BOT_TOKEN=                       # api.slack.com → your app → OAuth tokens
SLACK_SIGNING_SECRET=                  # api.slack.com → your app → Basic Info

# --- Ngrok (dev tunnel) ---
NGROK_AUTHTOKEN=REGENERATE_THIS       # dashboard.ngrok.com/authtokens — regenerate!
NGROK_DOMAIN=tremor-laptop-prepay.ngrok-free.dev
WEBHOOK_BASE_URL=https://tremor-laptop-prepay.ngrok-free.dev

# --- Databases (Docker — all self-hosted) ---
POSTGRES_URL=postgresql+asyncpg://dara:dara_dev@localhost:5432/dara
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dara_dev
ELASTICSEARCH_URL=http://localhost:9200
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=dara
MINIO_ROOT_PASSWORD=dara_dev_secret

# --- Pipeline Config ---
AUTO_MERGE_CONFIDENCE_THRESHOLD=0.88  # Float 0-1, default 0.88
MAX_CONTEXT_TOKENS=8000               # Hard cap for LLM context window
MAX_PIPELINE_RETRIES=3                # Max retries per agent stage
SANDBOX_TIMEOUT_SECONDS=120          # Docker sandbox hard kill timeout

# --- Optional Integrations ---
JIRA_API_TOKEN=                       # optional
PAGERDUTY_API_KEY=                    # optional
RESEND_API_KEY=                       # resend.com (free: 3000 emails/month)

# --- Production Only ---
VAULT_ADDR=                           # HashiCorp Vault address
VAULT_TOKEN=                          # HashiCorp Vault token
